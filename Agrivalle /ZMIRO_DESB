METHOD if_ex_invoice_update~change_at_save.

  DATA:
    lt_goodsmvt_item   TYPE TABLE OF bapi2017_gm_item_create,
    lt_return          TYPE TABLE OF bapiret2,
    ls_goodsmvt_header TYPE bapi2017_gm_head_01,
    ls_goodsmvt_code   TYPE bapi2017_gm_code,
    ls_return          TYPE bapiret2,
    ls_goodsmvt_item   LIKE LINE OF lt_goodsmvt_item,
    ls_mseg            TYPE mseg,
    lv_mblnr           TYPE bapi2017_gm_head_ret-mat_doc,
    lv_mjahr           TYPE bapi2017_gm_head_ret-doc_year,
    lv_buzei_ref       TYPE buzei.

  IF sy-tcode EQ 'MIRO'.

    ls_goodsmvt_code-gm_code      = '04'.
    ls_goodsmvt_header-pstng_date = sy-datum.
    ls_goodsmvt_header-doc_date   = sy-datum.

    LOOP AT ti_rseg_new INTO DATA(ls_mrmrseg).

      CLEAR ls_goodsmvt_item.

     SELECT SINGLE mtart FROM mara INTO @DATA(lv_material)
       WHERE matnr   = @ls_mrmrseg-matnr.

      SELECT SINGLE mtart FROM zmm_miro INTO @DATA(lv_mtart)
        WHERE mtart = @lv_material.

       IF  lv_mtart IS NOT INITIAL.
         CONTINUE.
       ENDIF.

    SELECT SINGLE qmatv FROM marc INTO @DATA(lv_qm)
      WHERE matnr = @ls_mrmrseg-matnr AND
            werks = @ls_mrmrseg-werks.

        IF lv_qm IS NOT INITIAL.
          SELECT SINGLE prueflos FROM qals INTO @DATA(ls_prueflos)
              WHERE matnr    = @ls_mrmrseg-matnr AND
                werk         = @ls_mrmrseg-werks AND
                ebeln        = @ls_mrmrseg-ebeln AND
                ebelp        = @ls_mrmrseg-ebelp.

          IF sy-subrc = 0.
            SELECT SINGLE vcode FROM qave INTO @DATA(ls_vcode)
              WHERE  prueflos = @ls_prueflos.

            IF sy-subrc <> 0 OR ( ls_vcode <> '01' AND ls_vcode <> '02' ).
              CONTINUE.
            ENDIF.
          ENDIF.
        ENDIF.

        SELECT SINGLE lgort  FROM ekpo INTO @DATA(ls_lgort)
          WHERE ebeln = @ls_mrmrseg-ebeln AND
                ebelp = @ls_mrmrseg-ebelp.

        SELECT SINGLE charg FROM ekbe INTO @DATA(ls_charg)
           WHERE ebeln = @ls_mrmrseg-ebeln AND
                 ebelp = @ls_mrmrseg-ebelp.

        IF sy-subrc = 0.
          ls_goodsmvt_item-stge_loc     = ls_lgort.
          ls_goodsmvt_item-batch        = ls_charg.
        ENDIF.

        ls_goodsmvt_item-stck_type    = 'S'.
        ls_goodsmvt_item-stck_type    = ls_mrmrseg-bwkey.
        ls_goodsmvt_item-material     = ls_mrmrseg-matnr.
        ls_goodsmvt_item-plant        = ls_mrmrseg-werks.
        ls_goodsmvt_item-entry_qnt    = ls_mrmrseg-menge.
        ls_goodsmvt_item-entry_uom    = ls_mrmrseg-meins.
        ls_goodsmvt_item-move_type = '343'.
        APPEND ls_goodsmvt_item TO lt_goodsmvt_item.
        SELECT SINGLE bwart FROM mseg INTO @DATA(lv_bw)
          WHERE matnr  = @ls_mrmrseg-matnr AND
                werks  = @ls_mrmrseg-werks.
        ENDLOOP.

        IF lt_goodsmvt_item IS NOT INITIAL.

          CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
            EXPORTING
              goodsmvt_header  = ls_goodsmvt_header
              goodsmvt_code    = ls_goodsmvt_code
            IMPORTING
              materialdocument = lv_mblnr
              matdocumentyear  = lv_mjahr
            TABLES
              goodsmvt_item    = lt_goodsmvt_item
              return           = lt_return.

          READ TABLE lt_return TRANSPORTING NO FIELDS
           WITH KEY type = 'S'
                    id    = 'L9'
                    number = '514'.

          IF sy-subrc = 0.
            CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
              EXPORTING
                wait = 'X'.
          ELSE.

            LOOP AT lt_return INTO ls_return WHERE type EQ 'E' OR type EQ 'A'.
              MESSAGE ID ls_return-id TYPE 'A' NUMBER ls_return-number
                       WITH ls_return-message_v1 ls_return-message_v2
                            ls_return-message_v3 ls_return-message_v4.
            ENDLOOP.
          ENDIF.

        ENDIF.
      ENDIF.
    ENDMETHOD.

