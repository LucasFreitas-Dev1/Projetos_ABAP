METHOD if_ex_invoice_update~change_at_save.

  DATA:
    lt_goodsmvt_item   TYPE TABLE OF bapi2017_gm_item_create,
    lt_return          TYPE TABLE OF bapiret2,
    ls_goodsmvt_header TYPE bapi2017_gm_head_01,
    ls_goodsmvt_code   TYPE bapi2017_gm_code,
    ls_return          TYPE bapiret2,
    ls_goodsmvt_item   LIKE LINE OF lt_goodsmvt_item,

* Variáveis do Loop e Acesso a Tabela
    ls_mseg            TYPE mseg,
    lv_mblnr           TYPE bapi2017_gm_head_ret-mat_doc,
    lv_mjahr           TYPE bapi2017_gm_head_ret-doc_year,
    lv_buzei_ref       TYPE buzei,
    lv_qm              TYPE qmatv.

  " Valida se o processo é a MIRO e se o usuário é o MVLFEITOSA
  IF sy-tcode EQ 'MIRO' AND sy-uname EQ 'MVLFEITOSA'.

    " Configura cabeçalho da BAPI para transferência (GM_CODE 04)
    ls_goodsmvt_code-gm_code      = '04'.
    ls_goodsmvt_header-pstng_date = sy-datum.
    ls_goodsmvt_header-doc_date   = sy-datum.

    " Inicia o loop nos itens da fatura que está sendo salva
    LOOP AT ti_rseg_new INTO DATA(ls_mrmrseg).

      " Limpa a estrutura do item para não repetir dados do item anterior
      CLEAR ls_goodsmvt_item.


      " Verifica se o material possui Controle de Qualidade ativo no mestre
      SELECT SINGLE qmatv FROM marc INTO @lv_qm
        WHERE matnr = @ls_mrmrseg-matnr AND
              werks = @ls_mrmrseg-werks.

      " Se o material for de QM, inicia as validações específicas
      IF lv_qm IS NOT INITIAL.
        " Busca o Lote de Controle (Inspeção) gerado na entrada
        SELECT SINGLE prueflos FROM qals INTO @DATA(ls_prueflos) "lote de controle
            WHERE matnr    = @ls_mrmrseg-matnr AND
              werk         = @ls_mrmrseg-werks AND
              ebeln        = @ls_mrmrseg-ebeln AND
              ebelp        = @ls_mrmrseg-ebelp.

        " Se encontrou o lote, busca o Código de Decisão de Uso (A1, A2, etc)
        IF sy-subrc = 0.
          SELECT SINGLE vcode FROM qave INTO @DATA(ls_vcode) "codigo de decisão  A1 aceito e A2 rejeitado
            WHERE  prueflos = @ls_prueflos.

          " Se a decisão for diferente de A1 (Aprovado), ignora este item e pula pro próximo
          IF ls_vcode <> 'A1'. "se for diferente de A1 cai no continue e pula todo o loop
            CONTINUE.
          ENDIF.
        ENDIF.
      ENDIF.

      " Busca o Depósito original no Pedido de Compra (EKPO)
      SELECT SINGLE lgort  FROM ekpo INTO @DATA(ls_lgort)
        WHERE ebeln = @ls_mrmrseg-ebeln AND
              ebelp = @ls_mrmrseg-ebelp.

      " Busca o Lote original no Histórico do Pedido (EKBE)
      SELECT SINGLE charg FROM ekbe INTO @DATA(ls_charg)
         WHERE ebeln = @ls_mrmrseg-ebeln AND
               ebelp = @ls_mrmrseg-ebelp.

      " Se encontrou o lote na EKBE, preenche os dados de destino
      IF sy-subrc = 0.
        ls_goodsmvt_item-stge_loc     = ls_lgort.
        ls_goodsmvt_item-batch        = ls_charg.
      ENDIF.

      " ATENÇÃO: Define estoque bloqueado 'S', mas a linha seguinte sobrescreve com BWKEY (Centro)
      ls_goodsmvt_item-stck_type    = 'S'.
      ls_goodsmvt_item-stck_type    = ls_mrmrseg-bwkey.

      " Preenche campos obrigatórios para o movimento da BAPI
      ls_goodsmvt_item-material     = ls_mrmrseg-matnr.
      ls_goodsmvt_item-plant        = ls_mrmrseg-werks.
      ls_goodsmvt_item-entry_qnt    = ls_mrmrseg-menge.
      ls_goodsmvt_item-entry_uom    = ls_mrmrseg-meins.

      " Define o tipo de movimento como 343 (Bloqueado para Livre)
      ls_goodsmvt_item-move_type = '343'.

      " Adiciona o item pronto na tabela que será enviada para a BAPI
      APPEND ls_goodsmvt_item TO lt_goodsmvt_item.

      " Se estiver em estoque livre ele pula a badi
      SELECT SINGLE BWART FROM MSEG INTO @DATA(lv_bw)
        WHERE matnr  = @ls_mrmrseg-matnr AND
              werks  = @ls_mrmrseg-werks.

    ENDLOOP.

    " Se a tabela de itens tiver dados, executa a BAPI de movimentação
    IF lt_goodsmvt_item IS NOT INITIAL.

      CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
        EXPORTING
          goodsmvt_header  = ls_goodsmvt_header
          goodsmvt_code    = ls_goodsmvt_code
        IMPORTING
          materialdocument = lv_mblnr
          matdocumentyear  = lv_mjahr
        TABLES
          goodsmvt_item    = lt_goodsmvt_item
          return           = lt_return.

      " Verifica se a BAPI retornou a mensagem de sucesso padrão (L9-514)
      READ TABLE lt_return TRANSPORTING NO FIELDS
       WITH KEY type = 'S'
                id    = 'L9'
                number = '514'.

      " Se deu certo, confirma a transação no banco (COMMIT)
      IF sy-subrc = 0.
        CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
          EXPORTING
            wait = 'X'.
      ELSE.
        " Se deu erro, percorre as mensagens da BAPI e exibe como erro fatal (Abort)
        LOOP AT lt_return INTO ls_return WHERE type EQ 'E' OR type EQ 'A'.
          MESSAGE ID ls_return-id TYPE 'A' NUMBER ls_return-number
                   WITH ls_return-message_v1 ls_return-message_v2
                        ls_return-message_v3 ls_return-message_v4.
        ENDLOOP.
      ENDIF.

    ENDIF.
  ENDIF.

ENDMETHOD.
