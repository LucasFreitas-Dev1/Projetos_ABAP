    IF screen-name = 'VG_ITEM_0004_6' OR screen-name = 'VG_QTDE_0004_6'.
      IF vg_item_0004_6 IS INITIAL OR vg_item_0004_6 = 0 OR vg_item_0004_6 = '000000'.
