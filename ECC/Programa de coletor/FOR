
FORM ZEXEC_CONF .

  v_cont = 1.

  IF CP_REMESSA IS INITIAL.
    C_TEXTO = 'Campo obrigatório.'.
    Return.
  ENDIF.

  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      input  = CP_REMESSA
    IMPORTING
      output = CP_REMESSA.

  SELECT *
     FROM lips
     INTO TABLE it_lips
     WHERE VBELN = CP_REMESSA.

  CLEAR it_aux_item.

  LOOP AT it_lips INTO wa_lips.

    READ TABLE it_aux_item INTO wa_aux_item WITH KEY matnr = wa_lips-matnr.

    IF sy-subrc = 0.

*      wa_aux_item-lfimg = wa_aux-lfimg + wa_conferidos-lfimg.
      MODIFY it_aux_item FROM wa_aux_item INDEX sy-tabix.
    ELSE.

      APPEND wa_lips TO it_aux_item.
    ENDIF.

  ENDLOOP.

  it_lips = it_aux_item.

    READ TABLE it_lips INTO wa_lips INDEX v_cont.

  C_REC_REMESSA = CP_REMESSA.
  CP_REMESSA3 = CP_REMESSA.
  CP_MAT = wa_lips-matnr.
  CP_DESCRI = wa_lips-arktx.


  IF SY-SUBRC <> 0.
    c_texto = 'Recebimento não encontrado.'.
    RETURN.
  ENDIF.


  "Trazer apenas os que nao foram conferidos ainda
  SELECT VBELN POSNR CONT LFIMG VOLUM
    FROM zwm_volum
    INTO TABLE it_volum
    WHERE vbeln = cp_remessa.

  "Se já tiver algo conferido, tira da it_lips
  IF it_volum[] IS NOT INITIAL.
    LOOP AT it_volum INTO wa_volum.
      DELETE it_lips WHERE posnr = wa_volum-posnr.
    ENDLOOP.
  ENDIF.

  "Tenta ler o primeiro item que sobrou
  READ TABLE it_lips INTO wa_lips INDEX v_cont.

  IF sy-subrc = 0.
    C_REC_REMESSA = CP_REMESSA.
    CP_REMESSA3   = CP_REMESSA.
    CP_MAT        = wa_lips-matnr.

      SHIFT CP_MAT LEFT DELETING LEADING '0'.

    CP_ITENS = |Item: { v_cont } de { lines( it_lips ) }|.

    CLEAR c_texto.
    CALL SCREEN 0002.
  ELSE.
    c_texto = 'Recebimento já está conferido!'.
  ENDIF.

ENDFORM.

FORM ZEXEC_BTN_PROX .

  " ve quantos itens tem
  v_total = lines( it_lips ).

  IF v_cont < v_total.
    v_cont = v_cont + 1.

    READ TABLE it_lips INTO wa_lips INDEX v_cont.
    cp_mat = wa_lips-matnr.
    CP_ITENS = |Item: { v_cont } de { v_total }|.

    clear cp_qtd.
  ELSE.
    cp_item =  'Último item atingido'.
  ENDIF.

ENDFORM.

